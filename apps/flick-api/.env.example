# PostgreSQL connection used by Prisma and the pg driver adapter.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/flick?schema=public

# At least 32 characters. Rotating this invalidates all active sessions.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated explicit origins; do not use * with credentialed cookies.
CORS_ORIGIN=http://localhost:3000

# Optional Redis cache. The API degrades to an in-process cache when absent.
REDIS_URL=redis://localhost:6379
PORT=3001

# Number of trusted reverse-proxy hops. Leave 0 when clients connect directly.
TRUST_PROXY_HOPS=0

# OTP delivery: "console" (dev/CI — logs codes) or "live" (real vendors).
# Must be "live" in production; the app refuses to boot otherwise.
OTP_DELIVERY=console
# OTP_SMS_ENDPOINT=https://vendor.example/send
# OTP_SMS_API_KEY=
# OTP_SMS_SENDER=Flick
# OTP_EMAIL_ENDPOINT=https://vendor.example/email
# OTP_EMAIL_API_KEY=
# OTP_EMAIL_FROM=no-reply@flick.co.th
# Service-wide 24h OTP send ceiling (defaults to 5000).
# OTP_GLOBAL_DAILY_CAP=5000

# Payment gateway: "fake" (dev/CI) or "omise". Must be "omise" in
# production — the fake gateway accepts webhooks it signed itself, which
# would mint free access.
PAYMENT_GATEWAY=fake
# Fake gateway's own dev/test HMAC secret. Has no meaning for Omise.
PAYMENT_WEBHOOK_SECRET=dev-secret
# Omise (Opn Payments) API secret key, used to authenticate outbound REST
# calls (e.g. charge creation). Required when PAYMENT_GATEWAY=omise.
# OMISE_SECRET_KEY=
# Base64-encoded webhook signing secret from the Omise dashboard (Webhooks
# Settings). Separate from OMISE_SECRET_KEY — this is what
# OmiseGatewayAdapter#verifyWebhook uses to check the Omise-Signature
# header on inbound webhooks. Required when PAYMENT_GATEWAY=omise.
# OMISE_WEBHOOK_SECRET=
# Omise source type used for checkout (e.g. "promptpay", "alipay",
# "internet_banking_bbl"). Defaults to "promptpay".
# OMISE_SOURCE_TYPE=promptpay
# Base URL the gateway sends the browser back to.
APP_BASE_URL=http://localhost:3000
