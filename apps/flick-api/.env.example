# PostgreSQL connection used by Prisma and the pg driver adapter.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/flick?schema=public

# At least 32 characters. Rotating this invalidates all active sessions.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated explicit origins; do not use * with credentialed cookies.
CORS_ORIGIN=http://localhost:3000

# Optional Redis cache. The API degrades to an in-process cache when absent.
REDIS_URL=redis://localhost:6379
PORT=3001

# Number of trusted reverse-proxy hops. Leave 0 when clients connect directly.
TRUST_PROXY_HOPS=0

# OTP delivery: "console" (dev/CI — logs codes) or "live" (real vendors).
# Must be "live" in production; the app refuses to boot otherwise.
OTP_DELIVERY=console
# OTP_SMS_ENDPOINT=https://vendor.example/send
# OTP_SMS_API_KEY=
# OTP_SMS_SENDER=Flick
# OTP_EMAIL_ENDPOINT=https://vendor.example/email
# OTP_EMAIL_API_KEY=
# OTP_EMAIL_FROM=no-reply@flick.co.th
# Service-wide 24h OTP send ceiling (defaults to 5000).
# OTP_GLOBAL_DAILY_CAP=5000
